# Frontend Environment Variables Example

# Backend API base URL (leave empty if using Vite proxy / relative path)
VITE_API_URL=http://localhost:3000

# Set to 'true' to use local mock data without connecting to MongoDB backend
VITE_USE_MOCK=false

# Optional: Public HTTPS base URL for mobile AR testing via ngrok / custom domain
# (e.g. https://your-tunnel.ngrok-free.app). If left empty, window.location.origin is used automatically.
VITE_PUBLIC_URL=
